# frozen_string_literal: true

# Local memory / logs — never shipped.
.aethercodex
.tm-ai/
.aether/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Bundled gems (per-machine, platform-specific — never committed)
ruby/.vendor_bundle/
ruby/vendor/
ruby/.bundle/
ruby/.portable/

# Built gem artifact (regenerated by `gem build`)
*.gem

# Temp probes / scratch scripts (never committed)
_daemon_probe.rb
*_probe*.rb
tmp_shell_smoke.rb

# Scratch artifacts (stray shell-redirect outputs)
/1000

# OS cruft
.DS_Store
Thumbs.db